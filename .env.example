AGENTPAY_ENABLE_WALLET_SEND=false
AGENTPAY_ENABLE_BINANCE_PAY=false
AGENTPAY_ENABLE_X402=false
AGENTPAY_X402_ALLOWED_HOSTS=
AGENTPAY_X402_BAZAAR_URLS=
# Server-only DeepSeek model access. Never expose this key through NEXT_PUBLIC_*.
DEEPSEEK_API_KEY=
AGENTPAY_DEEPSEEK_MODEL=deepseek-v4-flash
# AGENTPAY_DEEPSEEK_BASE_URL=https://api.deepseek.com
# Separate Binance Account key: enable Reading only, disable trading/withdrawals, and restrict by server IP.
BINANCE_READONLY_API_KEY=
BINANCE_READONLY_API_SECRET=
BINANCE_PORTFOLIO_DUST_USD=0.10
# AGENTPAY_BINANCE_READONLY_CONFIG=/home/agentpay/.local/share/agentpay/binance-readonly.json
# AGENTPAY_DB_PATH=/absolute/path/to/agentpay.sqlite
# PAYMENT_API_KEY and PAYMENT_API_SECRET must be injected server-side.
# AGENTPAY_PAYMENT_PYTHON=/home/ubuntu/.local/share/agentpay/payment-venv/bin/python

# Binance Onchain Pay partner integration (separate from Binance Portfolio and Binance Pay)
AGENTPAY_ENABLE_ONCHAIN_PAY=false
ONCHAIN_PAY_BASE_URL=
ONCHAIN_PAY_CLIENT_ID=
ONCHAIN_PAY_SIGN_ACCESS_TOKEN=
ONCHAIN_PAY_PRIVATE_KEY_PATH=
ONCHAIN_PAY_WEBHOOK_PUBLIC_KEY_PATH=
ONCHAIN_PAY_REDIRECT_URL=
ONCHAIN_PAY_FAIL_REDIRECT_URL=
ONCHAIN_PAY_MERCHANT_DISPLAY_NAME=AgentPay
